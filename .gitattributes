# Normalise line endings for text so Windows and Linux checkouts agree.
* text=auto

# ---- Unity text assets: treat as text, but never let Git try to merge them. ----
*.cs               text diff=csharp
*.shader           text
*.cginc            text
*.hlsl             text
*.compute          text
*.asmdef           text
*.json             text
*.md               text
*.txt              text
*.xml              text
*.yml              text

*.unity            merge=unity eol=lf
*.prefab           merge=unity eol=lf
*.asset            merge=unity eol=lf
*.mat              merge=unity eol=lf
*.overrideController merge=unity eol=lf
*.physicMaterial2D merge=unity eol=lf
*.meta             merge=unity eol=lf
*.inputactions     merge=unity eol=lf

# ---- Git LFS: binary assets ----
# Requires `git lfs install`; see README section 11.
*.png              filter=lfs diff=lfs merge=lfs -text
*.jpg              filter=lfs diff=lfs merge=lfs -text
*.jpeg             filter=lfs diff=lfs merge=lfs -text
*.psd              filter=lfs diff=lfs merge=lfs -text
*.tga              filter=lfs diff=lfs merge=lfs -text
*.tif              filter=lfs diff=lfs merge=lfs -text
*.gif              filter=lfs diff=lfs merge=lfs -text
*.aseprite         filter=lfs diff=lfs merge=lfs -text

*.wav              filter=lfs diff=lfs merge=lfs -text
*.mp3              filter=lfs diff=lfs merge=lfs -text
*.ogg              filter=lfs diff=lfs merge=lfs -text
*.aif              filter=lfs diff=lfs merge=lfs -text

*.fbx              filter=lfs diff=lfs merge=lfs -text
*.obj              filter=lfs diff=lfs merge=lfs -text
*.blend            filter=lfs diff=lfs merge=lfs -text

# Requested explicitly: tracked in LFS despite being Unity YAML text.
# Trade-off: this disables diff and the merge=unity driver for these files.
*.anim             filter=lfs diff=lfs merge=lfs -text
*.controller       filter=lfs diff=lfs merge=lfs -text

*.ttf              filter=lfs diff=lfs merge=lfs -text
*.otf              filter=lfs diff=lfs merge=lfs -text
*.mp4              filter=lfs diff=lfs merge=lfs -text
*.dll              filter=lfs diff=lfs merge=lfs -text
*.so               filter=lfs diff=lfs merge=lfs -text
